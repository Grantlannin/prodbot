+export function planIsForTomorrow(
+  plan: NightPrepTomorrowPlan | null,
+  now = Date.now()
+): boolean {
+  const normalized = normalizeNightPrepPlan(plan);
+  if (!normalized) return false;
+  return normalized.targetDateKey === tomorrowDateKey(now);
+}
