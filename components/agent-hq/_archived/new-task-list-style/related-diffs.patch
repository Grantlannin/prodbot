+  const today = normalizeTodayTaskList(todayStore, now);
+  if (!normalized?.tasks?.length) {
+    return { plan: normalized, today, didPromote: false };
+  }
+
+  const todayKey = localDateKey(now);
+  if (normalized.targetDateKey !== todayKey) {
+    return { plan: normalized, today, didPromote: false };
+  }
+  if (normalized.promotedToTodayDateKey === todayKey) {
+    return { plan: normalized, today, didPromote: false };
+  }
+
+  const existing = new Set(today.lines.map(l => l.text.trim().toLowerCase()).filter(Boolean));
+  const additions = normalized.tasks
+    .map(t => t.taskText.trim())
+    .filter(Boolean)
+    .filter(text => !existing.has(text.toLowerCase()))
+    .map(text => ({
+      id: makeTodayLineId(),
+      text,
+      createdAt: now,
+    }));
+
+  const nextToday: TodayTaskListStore = {
+    ...today,
+    dateKey: todayKey,
+    lines: [...today.lines, ...additions],
+    updatedAt: now,
+  };
+
+  const nextPlan: NightPrepTomorrowPlan = {
+    ...normalized,
+    promotedToTodayDateKey: todayKey,
+    updatedAt: now,
+  };
+
+  return { plan: nextPlan, today: nextToday, didPromote: true };
+}
