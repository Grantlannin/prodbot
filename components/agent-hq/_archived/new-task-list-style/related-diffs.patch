+
+export function makeHomelessPlanTask(text: string): NightPrepTomorrowTask | null {
+  const taskText = text.trim();
+  if (!taskText) return null;
+  const id =
+    typeof crypto !== 'undefined' && 'randomUUID' in crypto
+      ? crypto.randomUUID()
+      : Date.now().toString(36) + Math.random().toString(36).slice(2);
+  return {
+    projectId: '',
+    projectName: '',
+    taskId: `homeless-${id}`,
+    taskText,
+    homeless: true,
+  };
+}
