# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# Server-only — required for Stripe webhooks + billing writes
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Dashboard → Developers → API keys + Products
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# App URL for Stripe redirects (production)
NEXT_PUBLIC_APP_URL=https://www.daywinner.bot

# Full bot tutorial / first-watch video (YouTube or Loom share/embed URL).
# Used by in-app “How to start” modal + nav “full bot tutorial”.
NEXT_PUBLIC_LOOM_FULL_BOT_TUTORIAL_URL=https://www.youtube.com/watch?v=gjFPQ1Gy9Xw
# Optional aliases (fallbacks if FULL_BOT is unset):
# NEXT_PUBLIC_LOOM_HOW_TO_START_URL=
# NEXT_PUBLIC_LOOM_INTRO_URL=

# Chrome Web Store listing for the focus extension (onboarding + in-app modal)
NEXT_PUBLIC_CHROME_EXTENSION_STORE_URL=https://chromewebstore.google.com/detail/your-extension-id

# Resend — phone → laptop continue emails (required for scalable magic links)
# https://resend.com → API Keys + Domains (verify daywinner.bot DNS)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Daywinner <login@daywinner.bot>

# Vercel Cron auth for /api/cron/email-outbox
CRON_SECRET=long-random-string

# Ops dashboard (/ops) — comma-separated admin emails
ADMIN_EMAILS=you@daywinner.bot

# Optional: block the app until users sign in (auto-enabled when Stripe billing is configured)
# NEXT_PUBLIC_REQUIRE_AUTH=true

# Set to true to skip the paywall (dev/preview). Omit or false when Stripe keys are set.
# NEXT_PUBLIC_DISABLE_PAYWALL=true
# Server-only override: DISABLE_PAYWALL=true

# Setup checklist:
# 1. Run supabase/migrations/*.sql in order (include 005_email_outbox.sql)
# 2. Auth → Providers → enable Email
# 3. Auth → URL Configuration → Site URL = https://www.daywinner.bot
# 4. Redirect URLs: https://www.daywinner.bot/**  (includes /auth/callback + /auth/confirm)
# 5. Stripe → Product $4.99/mo → copy Price ID to STRIPE_PRICE_ID
# 6. Stripe → Webhooks → endpoint https://www.daywinner.bot/api/stripe/webhook (Enabled)
#    Events: checkout.session.completed, customer.subscription.created/updated/deleted
# 7. Resend → verify domain → RESEND_API_KEY + RESEND_FROM_EMAIL on Vercel (prodbot)
# 8. Add CRON_SECRET on Vercel (cron batch-drains email_outbox every minute)
# 9. Before a big launch: Resend paid plan + rate-limit increase; Supabase Pro;
#    ask Supabase to raise Auth/generateLink limits; Vercel Pro on prodbot
# 10. Run migrations through 006_email_outbox_sending.sql
# 11. Redeploy
